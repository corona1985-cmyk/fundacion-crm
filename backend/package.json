{
  "name": "crm-becas-backend",
  "version": "1.0.0",
  "description": "Backend API for CRM Fundación Rompiendo Paradigmas - Modules 1-7",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:coverage": "jest --runInBand --coverage --detectOpenHandles --forceExit",
    "db:migrate": "npx sequelize-cli db:migrate",
    "db:seed": "npx sequelize-cli db:seed:all",
    "create-admin": "node scripts/create-admin.js",
    "seed:academic": "node scripts/seed-academic-data.js",
    "seed:sponsors": "node scripts/seed-sponsors-data.js",
    "seed:financial": "node scripts/seed-financial-data.js",
    "migrate:excel": "node scripts/migrate-excel-data.js"
  },
  "keywords": [
    "crm",
    "express",
    "sequelize",
    "jwt",
    "postgresql"
  ],
  "author": "Fundación Rompiendo Paradigmas",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "@google-cloud/storage": "^7.21.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pdfkit": "^0.19.1",
    "pg": "^8.12.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "sequelize-cli": "^6.6.2",
    "sqlite3": "^5.1.7",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/src/config/",
      "/src/migrations/",
      "/src/seeders/",
      "/uploads/"
    ],
    "testTimeout": 10000
  }
}
