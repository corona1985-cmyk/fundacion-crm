NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
BASE_URL=http://localhost:5000

# Database Configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=crm_becas
DB_USER=postgres
DB_PASSWORD=postgres

# Database Test Configuration
DB_NAME_TEST=crm_becas_test

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_rompiendo_paradigmas_2026
JWT_EXPIRES_IN=24h

# Security / Hashing
SALT_ROUNDS=10

# Cloud Storage Configuration (STORAGE_PROVIDER: s3 | gcs | local)
STORAGE_PROVIDER=local

# AWS S3 Settings (Required if STORAGE_PROVIDER=s3)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
S3_BUCKET_NAME=crm-becas-documents

# Google Cloud Storage Settings (Required if STORAGE_PROVIDER=gcs)
GCS_PROJECT_ID=your_gcp_project_id
GCS_KEY_FILE=/path/to/gcp-key.json
GCS_BUCKET_NAME=crm-becas-documents
